          ],
          "classified_as": [
            {
              "id": "https://thanados.openatlas.eu/api/uuid/471960bb-3ee7-4303-9eab-32656fcfacee",
              "type": "Type",
              "_label": "Urbarium"
            },
            {
              "id": "https://vocab.getty.edu/aat/300435428",
              "type": "Type",
              "_label": "historical/cultural context",
              "classified_as": [
                {
                  "id": "https://vocab.getty.edu/aat/300137954",
                  "type": "Type",
                  "_label": "documents (by form)"
                }
              ]
            }
          ],
          "language": [
            {
              "id": "https://vocab.getty.edu/aat/300388277",
              "type": "Language",
              "_label": "English"
            }
          ],
          "content": "“Dieser Dernberg ligt unweith Haslach, Stinkhabrunn und Napperstorff, ist ein erhobener Higl, gleich einer Schanz, von Niedergang mit zwey: und gegen Aufgang undt Mittag nur mit einem Graben versehen, solle nach der gemeinen Sag noch vor Alters ein gebäu, oder Schloß darauf gestanden, undt versunckhen sein [...] Herunden am fueß dises Bergs, gegen Mittag, ist das dörfel Dernberg gelegen, so in 11 hauß, als ganzen Le[hen] halben und viertl Lehen bestandten, ist jetziger Zeit ganz oedt der Erden gleich, darvon jedoch die rudera noch gar wol zukhennen, ist dermal alda, wie auch ob: undt undterhalb ein zwymäthige Wisen” (Stiftsarchiv Zwettl; Lade 47 - IV - 1 a/b)"
        },
